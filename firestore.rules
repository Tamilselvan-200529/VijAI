/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has full
 * control over their own data tree, including their profile, chats, and
 * messages. No data is publicly accessible without authentication.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information. The {userId}
 *   corresponds to the Firebase Authentication UID.
 * - /users/{userId}/chats/{chatId}: Stores individual chat sessions for a user.
 * - /users/{userId}/chats/{chatId}/messages/{messageId}: Stores the messages
 *   for a specific chat session.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user document.
 * - Users can only read and write their own chats.
 * - Users can only read and write their own messages within their chats.
 * - Listing of users is disallowed.
 *
 * Denormalization for Authorization:
 * The rules leverage the hierarchical data structure to ensure that
 * authorization checks are efficient. For example, to access a message, the
 * rules implicitly verify that the user owns the parent chat and the overall
 * user data tree. No explicit denormalization is needed in this simple model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile if the UID matches the document ID.
     * @allow (get) Authenticated user can read their profile.
     * @allow (update) Authenticated user can update their own profile.
     * @allow (delete) Authenticated user can delete their own profile.
     * @deny (create) Unauthenticated users cannot create user profiles.
     * @deny (update) Authenticated user cannot update another user's profile.
     * @deny (delete) Authenticated user cannot delete another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to chat documents within a user's profile.
     * @path /users/{userId}/chats/{chatId}
     * @allow (create) Authenticated user can create chats under their own profile.
     * @allow (get) Authenticated user can read chats under their own profile.
     * @allow (list) Authenticated user can list chats under their own profile.
     * @allow (update) Authenticated user can update chats under their own profile.
     * @allow (delete) Authenticated user can delete chats under their own profile.
     * @deny (create) Authenticated user cannot create chats under another user's profile.
     * @deny (update) Authenticated user cannot update chats under another user's profile.
     * @deny (delete) Authenticated user cannot delete chats under another user's profile.
     * @principle Enforces document ownership for chats.
     */
    match /users/{userId}/chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to message documents within a chat session.
     * @path /users/{userId}/chats/{chatId}/messages/{messageId}
     * @allow (create) Authenticated user can create messages within their own chat sessions.
     * @allow (get) Authenticated user can read messages within their own chat sessions.
     * @allow (list) Authenticated user can list messages within their own chat sessions.
     * @allow (update) Authenticated user can update messages within their own chat sessions.
     * @allow (delete) Authenticated user can delete messages within their own chat sessions.
     * @deny (create) Authenticated user cannot create messages within chat sessions belonging to other users.
     * @deny (update) Authenticated user cannot update messages within chat sessions belonging to other users.
     * @deny (delete) Authenticated user cannot delete messages within chat sessions belonging to other users.
     * @principle Enforces document ownership for messages.
     */
    match /users/{userId}/chats/{chatId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}